# Copy to .env if you want to override defaults.

# InsightFace pack (buffalo_l is default). Use buffalo_s on slow CPUs.
# WARISPHERE_FACE_MODEL=buffalo_l

# auto | insightface | opencv
# WARISPHERE_FACE_BACKEND=auto

# Set to 1 to download ONNX weights from Hugging Face on startup.
# WARISPHERE_FACE_DOWNLOAD=0

# Ranked matches returned by POST /lost-person/scan-match
# WARISPHERE_FACE_MATCH_TOP_K=5

# Cosine similarity thresholds (never hard-code these in the app)
# WARISPHERE_FACE_SIM_HIGH=0.75
# WARISPHERE_FACE_SIM_POSSIBLE=0.55
# WARISPHERE_FACE_SIM_MIN=0.35

# Optional shared secret. When set, matching endpoints require
# header X-Authority-Token. Dashboard: VITE_AUTHORITY_TOKEN.
# WARISPHERE_AUTHORITY_TOKEN=

# WARISPHERE_FACE_WARMUP=1
# WARISPHERE_AUTO_FACE_PROCESS=1
