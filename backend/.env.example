# =====================================================================
# WariSphere backend environment configuration.
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored — NEVER commit real keys or tokens.
# Nothing here needs a value to run locally (SMS_PROVIDER=none works
# out of the box and performs no external HTTP requests).
# =====================================================================

# ---- Firebase --------------------------------------------------------
# Path to the service-account JSON. Default (firebase-service-account.json)
# works when the file sits next to the backend/ folder.
# FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# ---- SMS gateway -----------------------------------------------------
# Which provider sends SOS alert SMS:
#   none      - dev mode. Logs/records what would be sent; no HTTP request.
#   fast2sms  - Indian bulk SMS (https://www.fast2sms.com)
#   twilio    - international fallback (https://www.twilio.com)
SMS_PROVIDER=none

# Fast2SMS (primary for India). Create an API key at:
#   Fast2SMS dashboard -> Dev API -> Authorization key.
# Leave blank (and SMS_PROVIDER=none) for local development.
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=FSTSMS

# Twilio (alternative). From the Twilio console (Account Info):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# A Twilio number you own, in E.164, e.g. +14155550100
TWILIO_FROM_NUMBER=

# ---- SOS recipients --------------------------------------------------
# Control-room / help-desk numbers that receive EVERY SOS SMS, in
# addition to the pilgrim's ICE contact. Comma-separated; Indian
# 10-digit numbers are expanded with DEFAULT_COUNTRY_CODE automatically.
# Example: SOS_CONTROL_ROOM_NUMBERS=9876500000,+919876500001
SOS_CONTROL_ROOM_NUMBERS=

# Used to normalize local 10-digit numbers (Indian default).
DEFAULT_COUNTRY_CODE=+91

# HTTP timeout (seconds) for SMS provider requests.
SMS_TIMEOUT_SECONDS=10
